# Modelo do .env (VPS 2: ~/dev/planlabel/.env; VPS 3: /opt/planlabel/app.env).
# Copie, preencha as chaves e rode chmod 600. Sem aspas e sem espaços em volta do "=".
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Obrigatórios: o app não sobe sem eles.
PLANLABEL_MODEL1_PROVIDER=gemini
PLANLABEL_MODEL1_ID=gemini-decision-1
PLANLABEL_MODEL2_PROVIDER=openrouter
PLANLABEL_MODEL2_ID=typesafe/jev-1.14
PLANLABEL_ADVISOR_ID=gemini-3.5-flash-lite

# Opcionais (padrões do código; descomente para mudar). Ver docs/SPEC.md §7.
# PLANLABEL_DB_PATH=data/labels.sqlite3
# PLANLABEL_TRANSLATOR=google,mymemory
# PLANLABEL_MODEL1_RPM=200
# PLANLABEL_MODEL1_RPD=10000
# PLANLABEL_ADVISOR_RPM=15
# PLANLABEL_ADVISOR_TPM=25000
# PLANLABEL_ADVISOR_RPD=1000
